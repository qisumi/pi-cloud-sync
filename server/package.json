{
  "name": "@pi-cloud-sync/server",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted sync server for the pi coding agent",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "npm run build --prefix ../shared && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --prefix ../shared && node --import tsx --test tests/server.test.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:stop": "pm2 stop pi-cloud-sync",
    "pm2:delete": "pm2 delete pi-cloud-sync",
    "pm2:logs": "pm2 logs pi-cloud-sync",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@pi-cloud-sync/shared": "*",
    "better-sqlite3": "^11.5.0",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
