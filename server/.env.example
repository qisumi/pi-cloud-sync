# pi-cloud-sync server 配置示例
# 复制为 .env 或在 docker-compose 中设置

# 监听地址与端口
SYNC_HOST=0.0.0.0
SYNC_PORT=8787

# 数据目录（SQLite 数据库、token.txt）
SYNC_DATA_DIR=./data

# 访问令牌：客户端配置中用这个 token 连接。
# 多个令牌用逗号分隔；不设置则首次启动自动生成并保存到 data/token.txt
SYNC_TOKEN=

# 管理令牌：保护 /api/v1/admin/*（创建/撤销客户端令牌、查看统计）
# 不设置则管理 API 不可用（普通同步不受影响）
SYNC_ADMIN_TOKEN=

# 安全与限额
SYNC_MAX_BATCH=5000
SYNC_MAX_OBJECT_BYTES=10485760

# 对外 URL（仅用于文档展示）
SYNC_PUBLIC_URL=

# 日志级别：info | warn | error | debug
SYNC_LOG_LEVEL=info
